# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for provider=claude
ANTHROPIC_API_KEY=

# First admin account, created on the first start when there are no users yet.
# If ADMIN_PASSWORD is empty, a random password is generated and printed once in the logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# REPORT_LANGUAGE=English
# WORKER_COUNT=2
# HISTORY_RUNS=3
# MAX_TOOL_CALLS=5
# TOOL_TIMEOUT_SECONDS=120
# TOOL_MAX_OUTPUT_CHARS=20000
# LOCAL_LLM_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=llama3.1
# PORT=8000
# MAX_UPLOAD_MB=500
# PCAP_RETENTION_DAYS=0          # delete uploaded pcaps of finished runs after N days (0 = keep)
# SESSION_TTL_HOURS=168
# SESSION_COOKIE_SECURE=0        # set to 1 when served over HTTPS
# MODEL_PRICES_JSON={"claude-opus-5-5": [4.0, 20.0, 0.2]}   # USD per MTok: input, output, cache read
