# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for provider=claude
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# REPORT_LANGUAGE=English
# WORKER_COUNT=2
# HISTORY_RUNS=3
# MAX_TOOL_CALLS=5
# TOOL_TIMEOUT_SECONDS=120
# TOOL_MAX_OUTPUT_CHARS=20000
# LOCAL_LLM_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=llama3.1
# PORT=8000
